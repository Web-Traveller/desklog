{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskLog",
  "version": "1.0.1",
  "identifier": "com.desklog.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskLog - Desk Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEEwNEQyNzE2MjUxMDEKUldRQlVXSngwZ1NLclIyeFNvbkJRdkMycHI4azAwUnFoVGs4TytGRTh6aEw4VzlsKytSQVhPSVQK",
      "endpoints": [
        "https://github.com/Web-Traveller/desklog/releases/latest/download/latest.json"
      ]
    }
  }
}
